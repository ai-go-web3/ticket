# ===== Django =====
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production

# ===== MySQL =====
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_DATABASE=movie_ticket
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ===== Redis =====
# USE_REDIS：是否启用 Redis 缓存。
#   false = 降级为本地内存缓存（LocMemCache），后端无需 Redis 即可跑通（默认，适合先上验证）
#   true  = 生产标准，需 REDIS_HOST 可达；锁座快路径 / token 缓存走 Redis
USE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== 微信小程序 =====
# 小程序 AppID / AppSecret（微信公众平台 -> 开发管理 -> 开发设置）。
# 留空则登录走「开发降级」（openid = dev_<code>），仅用于本地联调；生产必须配置。
WX_APPID=
WX_SECRET=
# 微信支付（商户号/API v2 密钥/回调地址，支付环节才需要）
WX_MCHID=
WX_PAY_KEY=
WX_NOTIFY_URL=

# ===== 麻花电影 =====
MAHUA_BASE_URL=
MAHUA_APP_KEY=
MAHUA_APP_SECRET=

# ===== 业务参数 =====
SEAT_LOCK_TTL=600
PAY_TIMEOUT=900
JWT_EXPIRE_SECONDS=7200

# ===== 运维/定时任务 =====
# 内部同步接口 POST /api/v1/catalog/sync-movies 的共享令牌，由微信云托管「定时任务」
# 在请求头 X-Task-Token 携带。留空则该接口一律拒绝（安全默认）。请生成一个随机长串，
# 例如： python -c "import secrets;print(secrets.token_urlsafe(32))"
TASK_TOKEN=
# 影片同步默认城市（麻花 cityId，成都=8），可被接口 body 的 city 覆盖
SYNC_DEFAULT_CITY=8
