# ===== Django =====
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production

# ===== MySQL =====
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_DATABASE=movie_ticket
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ===== 微信小程序 =====
# 小程序 AppID / AppSecret（微信公众平台 -> 开发管理 -> 开发设置）。
# 留空则登录走「开发降级」（openid = dev_<code>），仅用于本地联调；生产必须配置。
WX_APPID=
WX_SECRET=
# 微信支付（商户号/API v2 密钥/回调地址，支付环节才需要）
WX_MCHID=
WX_PAY_KEY=
WX_NOTIFY_URL=

# ===== 麻花电影 =====
MAHUA_BASE_URL=
MAHUA_APP_KEY=
MAHUA_APP_SECRET=

# ===== 业务参数 =====
SEAT_LOCK_TTL=600
PAY_TIMEOUT=900
JWT_EXPIRE_SECONDS=7200

# ===== 运维/定时任务 =====
# 内置定时器（APScheduler，进程内触发，不依赖外部调用）——同步影片的主开关。
# 默认开启。⚠️ 微信云托管须把服务「最小副本数」设为 ≥1，否则缩容到 0 时进程不在、定时器不触发。
ENABLE_SCHEDULER=true
# 每天同步的北京时间时点，逗号分隔 HH:MM（去重用进程内缓存锁，建议单副本常驻）
SYNC_CRON_TIMES=00:30,13:00
# 影片同步默认城市（麻花 cityId，成都=8），可被接口 body 的 city 覆盖
SYNC_DEFAULT_CITY=8
# 手动/外部触发同步接口 POST /api/v1/catalog/sync-movies 的共享令牌（请求头 X-Task-Token）。
# 内置定时器不需要它；仅在你想用 HTTP 接口手动补跑时用到。留空则该接口一律拒绝（安全默认）。
# 生成随机长串： python -c "import secrets;print(secrets.token_urlsafe(32))"
TASK_TOKEN=
