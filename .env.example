# ===== Django =====
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production

# ===== MySQL =====
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_DATABASE=movie_ticket
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ===== 微信小程序 =====
# 小程序 AppID / AppSecret（微信公众平台 -> 开发管理 -> 开发设置）。
# 仅 DEBUG=true 且未配置时，登录走「开发降级」（openid = dev_<code>）用于本地联调；
# 生产（DEBUG=false）未配置凭证会直接拒绝登录（防止假 openid 每次新建用户、孤儿化订单）。
WX_APPID=
WX_SECRET=
# 微信支付（商户号/API v2 密钥/回调地址，支付环节才需要）
WX_MCHID=
WX_PAY_KEY=
WX_NOTIFY_URL=
# 微信退款：商户API证书（apiclient_cert.pem/apiclient_key.pem 路径，缺一则退款降级为骨架标记）
# WX_REFUND_NOTIFY_URL 留空会从 WX_NOTIFY_URL 自动推导（/pay/callback -> /pay/refund-notify）
WX_MCH_CERT_PATH=
WX_MCH_KEY_PATH=
WX_REFUND_NOTIFY_URL=
# 真实支付联调开关：强制所有订单实付金额（分）。=1 即 0.01 元走全链路；
# 联调完务必删除或置 0 恢复票价计费（生产必须留空/0）。
PAY_AMOUNT_OVERRIDE_FEN=
# 微信接口 SSL 严格模式（默认关闭降级开关）。云托管内调 api.weixin.qq.com 证书校验
# 失败时会自动降级 HTTP 内网链路重试；设为 true 可禁止降级（强制 HTTPS 严格校验）。
WX_HTTP_STRICT_SSL=

# ===== 麻花电影 =====
MAHUA_BASE_URL=
# 放单总限价（元，costTotalPrice）：实际成本高于该价麻花拒绝出单。
# 联调可设 0.01 保证不出票（订单走出票失败->自动退款）；生产留空或设合理成本上限。
MAHUA_COST_TOTAL_PRICE=
MAHUA_APP_KEY=
MAHUA_APP_SECRET=

# ===== 业务参数 =====
# 成本价上浮费率：fastPrice/maxSpeedPrice 为成本价，展示与计价前先上浮（0.05 = 5%）。
# 留空/0 = 不上浮。详见 config/settings.py PRICE_MARKUP_RATE。
PRICE_MARKUP_RATE=0.05
PAY_TIMEOUT=900
JWT_EXPIRE_SECONDS=7200

# ===== 运维/定时任务 =====
# 内置定时器（APScheduler，进程内触发，不依赖外部调用）——主开关。
# 默认开启。⚠️ 微信云托管须把服务「最小副本数」设为 ≥1，否则缩容到 0 时进程不在、定时器不触发。
ENABLE_SCHEDULER=true
# 待映影片全量拉取间隔（分钟，默认 720 = 12 小时）。comingList 为全国分页数据，
# 定时任务循环拉到拉空（上限 100 条）；列表接口另有 12 小时缓存。
COMING_PULL_MINUTES=720
# 【已废弃】影片同步机制已重构：热映改为按需实时拉取（pull_movies，1h 缓存），
# 此配置定时器不再使用，保留无副作用，可删除。
SYNC_CRON_TIMES=00:30,13:00
# 影片同步默认城市（麻花 cityId，成都=8），热映按需拉取时作默认城市，可被接口 body 覆盖
SYNC_DEFAULT_CITY=8
# 手动/外部触发同步接口 POST /api/v1/catalog/sync-movies 的共享令牌（请求头 X-Task-Token）。
# 内置定时器不需要它；仅在你想用 HTTP 接口手动补跑时用到。留空则该接口一律拒绝（安全默认）。
# 生成随机长串： python -c "import secrets;print(secrets.token_urlsafe(32))"
TASK_TOKEN=
