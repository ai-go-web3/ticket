# ==== 敏感 / 不应进镜像 ====
.env
.env.*
!.env.example

# ==== Python ====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ==== 本地数据库 / 静态产物 ====
db_dev.sqlite3
db.sqlite3
staticfiles/
media/

# ==== 日志 ====
*.log
logs/

# ==== 版本控制 / IDE ====
.git/
.gitignore
.idea/
.vscode/
.DS_Store

# ==== 开发文档（可选，减小镜像体积）====
*.md
docs/
# 开发/联调用脚本不进镜像，但 fetch_certs.py（启动时从对象存储拉证书）必须保留。
scripts/*
!scripts/fetch_certs.py
